@@ -0,0 +1,456 @@
+//! Private exact-element classifier. No AX values, labels or identifiers are read.
+use super::bindings::{
+    copy_element_attr, copy_string_attr, kAXErrorAttributeUnsupported, kAXErrorNoValue,
+    kAXErrorSuccess, AXUIElementCopyAttributeNames, AXUIElementCopyAttributeValue, AXUIElementRef,
+};
+use super::cache::RetainedElement;
+use core_foundation::array::{
+    CFArrayGetCount, CFArrayGetTypeID, CFArrayGetValueAtIndex, CFArrayRef,
+};
+use core_foundation::base::{CFEqual, CFRelease, CFTypeRef, TCFType};
+use core_foundation::string::{CFString, CFStringGetLength};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Security {
+    NonSensitive,
+    Sensitive,
+    Unknown,
+}
+impl Security {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::NonSensitive => "non_sensitive",
+            Self::Sensitive => "sensitive",
+            Self::Unknown => "unknown",
+        }
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Subrole {
+    Known(String),
+    Absent,
+    Unreadable,
+}
+
+/// Complete native attribute inventory, bounded and type checked. This is not
+/// absence inferred from an incomplete projected tree or missing SDK DTO field.
+unsafe fn attributes_prove_no_subrole(names: CFArrayRef) -> bool {
+    if names.is_null()
+        || core_foundation::base::CFGetTypeID(names as CFTypeRef) != CFArrayGetTypeID()
+    {
+        return false;
+    }
+    let count = CFArrayGetCount(names);
+    if !(1..=128).contains(&count) {
+        return false;
+    }
+    let mut role_declared = false;
+    for index in 0..count {
+        let value = CFArrayGetValueAtIndex(names, index) as CFTypeRef;
+        if value.is_null()
+            || core_foundation::base::CFGetTypeID(value) != CFString::type_id()
+            || CFStringGetLength(value as _) > 128
+        {
+            return false;
+        }
+        let name = CFString::wrap_under_get_rule(value as _).to_string();
+        if name == "AXSubrole" {
+            return false;
+        }
+        if name == "AXRole" {
+            role_declared = true;
+        }
+    }
+    role_declared
+}
+unsafe fn declared_no_subrole(element: AXUIElementRef) -> bool {
+    let mut names: CFArrayRef = std::ptr::null();
+    let status = AXUIElementCopyAttributeNames(element, &mut names);
+    let result = status == kAXErrorSuccess && attributes_prove_no_subrole(names);
+    if !names.is_null() {
+        CFRelease(names as CFTypeRef);
+    }
+    result
+}
+
+/// Absent is only a native AX absent/no-value result, never a missing DTO field.
+unsafe fn read_subrole(element: AXUIElementRef) -> Subrole {
+    let attr = CFString::new("AXSubrole");
+    let mut value: CFTypeRef = std::ptr::null();
+    let status = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    let result = if status == kAXErrorNoValue
+        || (status == kAXErrorAttributeUnsupported && declared_no_subrole(element))
+    {
+        Subrole::Absent
+    } else if status == kAXErrorSuccess
+        && !value.is_null()
+        && core_foundation::base::CFGetTypeID(value) == CFString::type_id()
+        && CFStringGetLength(value as _) <= 128
+    {
+        Subrole::Known(CFString::wrap_under_get_rule(value as _).to_string())
+    } else {
+        Subrole::Unreadable
+    };
+    if !value.is_null() {
+        CFRelease(value);
+    }
+    result
+}
+
+fn classify_chain(chain: &[(String, Subrole)], reached_window: bool) -> Security {
+    if chain.iter().any(|(role, subrole)| {
+        role == "AXSecureTextField"
+            || matches!(subrole, Subrole::Known(value) if value == "AXSecureTextField")
+    }) {
+        return Security::Sensitive;
+    }
+    if !reached_window
+        || chain.is_empty()
+        || chain
+            .iter()
+            .any(|(_, subrole)| *subrole == Subrole::Unreadable)
+    {
+        return Security::Unknown;
+    }
+    // Deliberately narrow editable roles; arbitrary custom/web controls stay unknown.
+    if !matches!(chain[0].0.as_str(), "AXTextField" | "AXTextArea") {
+        return Security::Unknown;
+    }
+    // The addressed input itself must have native no-subrole evidence. A custom
+    // subtype on an input is never accepted. Layout ancestors have no typing
+    // destination of their own; their subtype does not redefine the exact child's
+    // basic AXTextField/AXTextArea role. Secure ancestors were refused above.
+    if matches!(&chain[0].1, Subrole::Known(value) if !value.is_empty()) {
+        return Security::Unknown;
+    }
+    if chain.iter().skip(1).any(|(role, _)| {
+        !matches!(
+            role.as_str(),
+            "AXWindow"
+                | "AXGroup"
+                | "AXScrollArea"
+                | "AXSplitGroup"
+                | "AXList"
+                | "AXLayoutArea"
+                | "AXLayoutItem"
+        )
+    }) {
+        return Security::Unknown;
+    }
+    Security::NonSensitive
+}
+
+/// Caller retains the addressed element and verifies its exact PID/window binding.
+/// The bounded ancestor walk must reach that same window. Cycles and read errors
+/// never establish non-sensitive. No role/subrole strings leave this classifier.
+pub unsafe fn classify_exact(
+    element: AXUIElementRef,
+    window_id: u32,
+) -> (Security, Option<&'static str>) {
+    let mut retained = vec![RetainedElement::retain(element as usize)];
+    let mut chain = Vec::new();
+    let mut reached_window = false;
+    for _ in 0..40 {
+        let current = retained.last().unwrap().as_ptr() as AXUIElementRef;
+        if retained[..retained.len() - 1]
+            .iter()
+            .any(|prior| CFEqual(prior.as_ptr() as CFTypeRef, current as CFTypeRef) != 0)
+        {
+            break;
+        }
+        let Some(role) = copy_string_attr(current, "AXRole") else {
+            break;
+        };
+        chain.push((role.clone(), read_subrole(current)));
+        if role == "AXWindow" {
+            reached_window = super::bindings::ax_get_window_id(current) == Some(window_id);
+            break;
+        }
+        let Some(parent) = copy_element_attr(current, "AXParent") else {
+            break;
+        };
+        retained.push(RetainedElement::retain(parent as usize));
+        CFRelease(parent as CFTypeRef);
+    }
+    let classification = classify_chain(&chain, reached_window);
+    let reason = if classification != Security::Unknown {
+        None
+    } else if !reached_window || chain.is_empty() {
+        Some("ancestry_unconfirmed")
+    } else if chain[0].1 == Subrole::Unreadable {
+        Some("leaf_subrole_unreadable")
+    } else if chain
+        .iter()
+        .skip(1)
+        .any(|(_, subrole)| *subrole == Subrole::Unreadable)
+    {
+        Some("ancestor_subrole_unreadable")
+    } else if !matches!(chain[0].0.as_str(), "AXTextField" | "AXTextArea") {
+        Some("unsupported_role")
+    } else if matches!(&chain[0].1, Subrole::Known(value) if value == "AXUnknown") {
+        Some("generic_leaf_subrole")
+    } else if chain
+        .iter()
+        .skip(1)
+        .any(|(_, subrole)| matches!(subrole, Subrole::Known(value) if value == "AXUnknown"))
+    {
+        Some("generic_ancestor_subrole")
+    } else if matches!(&chain[0].1, Subrole::Known(value) if !value.is_empty()) {
+        Some("leaf_custom_subrole")
+    } else if chain.iter().skip(1).any(|(_, subrole)| matches!(subrole, Subrole::Known(value) if value == "AXSectionList")) {
+        Some("ancestor_section_list")
+    } else if chain.iter().skip(1).any(|(_, subrole)| matches!(subrole, Subrole::Known(value) if value == "AXCollectionList")) {
+        Some("ancestor_collection_list")
+    } else if chain.iter().skip(1).any(|(_, subrole)| matches!(subrole, Subrole::Known(value) if value == "AXContentList")) {
+        Some("ancestor_content_list")
+    } else if chain.iter().skip(1).any(|(_, subrole)| matches!(subrole, Subrole::Known(value) if value == "AXDialog" || value == "AXFloatingWindow")) {
+        Some("ancestor_other_window")
+    } else {
+        Some("ancestor_custom_subrole")
+    };
+    (classification, reason)
+}
+
+/// Opt-in native admission contract. Only exact current tokens may request it;
+/// a coordinate/legacy/focused fallback cannot silently substitute a target.
+pub fn input_security_required(
+    args: &serde_json::Value,
+) -> Result<bool, cua_driver_core::protocol::ToolResult> {
+    let required = match args.get("require_non_sensitive") {
+        None | Some(serde_json::Value::Bool(false)) => false,
+        Some(serde_json::Value::Bool(true)) => true,
+        _ => return Err(input_security_refusal()),
+    };
+    if required
+        && (args
+            .get("pid")
+            .and_then(|value| value.as_i64())
+            .is_none_or(|value| value <= 0 || value > i32::MAX as i64)
+            || args
+                .get("window_id")
+                .and_then(|value| value.as_u64())
+                .is_none_or(|value| value == 0 || value > u32::MAX as u64)
+            || args
+                .get("element_token")
+                .and_then(|value| value.as_str())
+                .is_none_or(|value| value.is_empty() || value.len() > 1024)
+            || args.get("element_index").is_some()
+            || args.get("x").is_some()
+            || args.get("y").is_some()
+            || args.get("scope").and_then(|value| value.as_str()) == Some("desktop"))
+    {
+        return Err(input_security_refusal());
+    }
+    Ok(required)
+}
+
+fn input_security_refusal() -> cua_driver_core::protocol::ToolResult {
+    cua_driver_core::protocol::ToolResult::error("Exact non-sensitive input target required")
+        .with_structured(
+            serde_json::json!({"code":"input_security_unconfirmed", "effect":"refused"}),
+        )
+}
+
+/// Preflight precedes background/focus routing; the retained clone survives the
+/// blocking read. Admission is repeated in each actuator, not cached by this read.
+pub async fn input_security_preflight(
+    required: bool,
+    pid: i32,
+    window_id: Option<u32>,
+    element: Option<RetainedElement>,
+) -> Result<(), cua_driver_core::protocol::ToolResult> {
+    if !required {
+        return Ok(());
+    }
+    let admitted = tokio::task::spawn_blocking(move || unsafe {
+        admit_input(
+            true,
+            pid,
+            window_id,
+            element.as_ref().map(|element| element.as_ptr()),
+            false,
+        )
+    })
+    .await;
+    match admitted {
+        Ok(Ok(())) => Ok(()),
+        _ => Err(input_security_refusal()),
+    }
+}
+
+fn input_admitted(bound: bool, security: Security, focus: Option<bool>) -> bool {
+    bound && security == Security::NonSensitive && focus != Some(false)
+}
+
+/// Repeat exact-object binding/classification immediately before native input.
+/// The caller must keep the SDK RetainedElement alive throughout this call and
+/// the actuator; this function never resolves another token or reads AX values.
+pub unsafe fn admit_input(
+    required: bool,
+    pid: i32,
+    window_id: Option<u32>,
+    element: Option<usize>,
+    require_focus: bool,
+) -> anyhow::Result<()> {
+    if !required {
+        return Ok(());
+    }
+    let Some((window_id, pointer)) = window_id.zip(element).filter(|(_, pointer)| *pointer != 0)
+    else {
+        anyhow::bail!("input_security_unconfirmed");
+    };
+    #[link(name = "ApplicationServices", kind = "framework")]
+    extern "C" {
+        fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> i32;
+    }
+    let element = pointer as AXUIElementRef;
+    let mut actual_pid = 0;
+    let bound = AXUIElementGetPid(element, &mut actual_pid) == kAXErrorSuccess
+        && actual_pid == pid
+        && pid > 0
+        && super::exact_target::element_window_id(element) == Some(window_id)
+        && crate::windows::resolve_window_owner(pid, window_id)
+            == crate::windows::WindowOwner::SamePid;
+    if !bound {
+        anyhow::bail!("input_security_unconfirmed");
+    }
+    let (security, _) = classify_exact(element, window_id);
+    let focus = if require_focus {
+        let focused = super::exact_target::focused_element_in_window(pid, window_id);
+        let same = focused.is_some_and(|focused| {
+            let same = CFEqual(element as CFTypeRef, focused as CFTypeRef) != 0;
+            CFRelease(focused as CFTypeRef);
+            same
+        });
+        Some(same)
+    } else {
+        None
+    };
+    if !input_admitted(bound, security, focus) {
+        anyhow::bail!("input_security_unconfirmed");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn input_admission_requires_positive_security_and_exact_focus() {
+        for bound in [false, true] {
+            for security in [
+                Security::Unknown,
+                Security::Sensitive,
+                Security::NonSensitive,
+            ] {
+                for focus in [None, Some(false), Some(true)] {
+                    assert_eq!(
+                        input_admitted(bound, security, focus),
+                        bound && security == Security::NonSensitive && focus != Some(false)
+                    );
+                }
+            }
+        }
+    }
+    #[test]
+    fn guarded_input_shape_rejects_fallbacks_before_native_access() {
+        use serde_json::json;
+        let valid =
+            json!({"pid":1,"window_id":2,"element_token":"opaque","require_non_sensitive":true});
+        assert_eq!(input_security_required(&valid).unwrap(), true);
+        for (key, value) in [
+            ("pid", json!(false)),
+            ("window_id", json!(0)),
+            ("element_token", json!("")),
+            ("require_non_sensitive", json!(1)),
+            ("element_index", json!(0)),
+            ("x", json!(1)),
+            ("y", json!(1)),
+            ("scope", json!("desktop")),
+        ] {
+            let mut args = valid.clone();
+            args[key] = value;
+            assert!(input_security_required(&args).is_err(), "{key}");
+        }
+        assert_eq!(input_security_required(&json!({})).unwrap(), false);
+        // Missing retained target is refused before any AX API is called.
+        assert!(unsafe { admit_input(true, 1, Some(2), None, false) }.is_err());
+    }
+    fn normal() -> Vec<(String, Subrole)> {
+        vec![
+            ("AXTextField".into(), Subrole::Absent),
+            ("AXWindow".into(), Subrole::Absent),
+        ]
+    }
+    #[test]
+    fn complete_attribute_inventory_is_required_for_absence() {
+        use core_foundation::array::CFArray;
+        let role = CFString::new("AXRole");
+        let title = CFString::new("AXTitle");
+        let subrole = CFString::new("AXSubrole");
+        let complete = CFArray::from_CFTypes(&[role.clone(), title.clone()]);
+        assert!(unsafe { attributes_prove_no_subrole(complete.as_concrete_TypeRef()) });
+        let present = CFArray::from_CFTypes(&[role.clone(), subrole]);
+        assert!(!unsafe { attributes_prove_no_subrole(present.as_concrete_TypeRef()) });
+        let inconsistent = CFArray::from_CFTypes(&[title]);
+        assert!(!unsafe { attributes_prove_no_subrole(inconsistent.as_concrete_TypeRef()) });
+        let oversized = CFArray::from_CFTypes(&vec![role; 129]);
+        assert!(!unsafe { attributes_prove_no_subrole(oversized.as_concrete_TypeRef()) });
+        assert!(!unsafe { attributes_prove_no_subrole(std::ptr::null()) });
+    }
+    #[test]
+    fn known_normal_native_chain() {
+        assert_eq!(classify_chain(&normal(), true), Security::NonSensitive);
+    }
+    #[test]
+    fn unreadable_or_incomplete_is_unknown() {
+        let mut chain = normal();
+        chain[0].1 = Subrole::Unreadable;
+        assert_eq!(classify_chain(&chain, true), Security::Unknown);
+        assert_eq!(classify_chain(&normal(), false), Security::Unknown);
+    }
+    #[test]
+    fn secure_subrole_and_ancestor_win() {
+        for index in 0..2 {
+            let mut chain = normal();
+            chain[index].1 = Subrole::Known("AXSecureTextField".into());
+            assert_eq!(classify_chain(&chain, true), Security::Sensitive);
+        }
+    }
+    #[test]
+    fn known_layout_subtype_does_not_replace_the_exact_input_type() {
+        let chain = vec![
+            ("AXTextField".into(), Subrole::Absent),
+            ("AXGroup".into(), Subrole::Known("layout subtype".into())),
+            ("AXWindow".into(), Subrole::Known("AXStandardWindow".into())),
+        ];
+        assert_eq!(classify_chain(&chain, true), Security::NonSensitive);
+        let mut secure = chain.clone();
+        secure[1].1 = Subrole::Known("AXSecureTextField".into());
+        assert_eq!(classify_chain(&secure, true), Security::Sensitive);
+        let mut editable = chain.clone();
+        editable[1].0 = "AXTextArea".into();
+        assert_eq!(classify_chain(&editable, true), Security::Unknown);
+        let mut custom = chain.clone();
+        custom[1].0 = "custom role".into();
+        assert_eq!(classify_chain(&custom, true), Security::Unknown);
+        let mut unreadable = chain;
+        unreadable[1].1 = Subrole::Unreadable;
+        assert_eq!(classify_chain(&unreadable, true), Security::Unknown);
+    }
+    #[test]
+    fn explicit_unknown_subrole_stays_unknown() {
+        let mut chain = normal();
+        chain[0].1 = Subrole::Known("AXUnknown".into());
+        assert_eq!(classify_chain(&chain, true), Security::Unknown);
+    }
+    #[test]
+    fn custom_role_or_subrole_is_unknown() {
+        let mut chain = normal();
+        chain[0].0 = "AXGroup".into();
+        assert_eq!(classify_chain(&chain, true), Security::Unknown);
+        let mut chain = normal();
+        chain[0].1 = Subrole::Known("AXSearchField".into());
+        assert_eq!(classify_chain(&chain, true), Security::Unknown);
+    }
+}
