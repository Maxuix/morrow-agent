index 0000000..3e1ffa2
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/get_element_security.rs
@@ -0,0 +1,145 @@
+//! Prototype closed read-only query resolving the SDK's retained element cache.
+use super::ToolState;
+use crate::ax::{
+    bindings::{kAXErrorSuccess, AXUIElementRef},
+    element_security::{classify_exact, Security},
+    exact_target::element_window_id,
+};
+use crate::windows::{resolve_window_owner, WindowOwner};
+use async_trait::async_trait;
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{Tool, ToolDef},
+    tool_args::parse_typed_input,
+};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::sync::Arc;
+
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" {
+    fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> i32;
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    pid: i32,
+    window_id: u32,
+    element_token: String,
+    session: Option<String>,
+}
+
+pub struct GetElementSecurityTool {
+    state: Arc<ToolState>,
+}
+impl GetElementSecurityTool {
+    pub fn new(state: Arc<ToolState>) -> Self {
+        Self { state }
+    }
+}
+static DEF: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+fn output(security: Security, binding_verified: bool, reason: Option<&str>) -> ToolResult {
+    ToolResult::text("Bounded element security classification").with_structured(json!({
+        "schema_version": 2, "input_guard_version": 1,
+        "classification": security.label(), "binding_verified": binding_verified,
+        "reason": reason
+    }))
+}
+
+#[async_trait]
+impl Tool for GetElementSecurityTool {
+    fn def(&self) -> &ToolDef {
+        DEF.get_or_init(|| ToolDef {
+            name: "get_element_security".into(),
+            description: "Read a closed security classification for one current exact SDK token; no field values or attributes are returned.".into(),
+            input_schema: json!({"type":"object","properties":{
+                "pid":{"type":"integer","minimum":1}, "window_id":{"type":"integer","minimum":1},
+                "element_token":{"type":"string","minLength":1,"maxLength":1024},
+                "session":cua_driver_core::tool_schema::session_schema()
+            },"required":["pid","window_id","element_token"],"additionalProperties":false}),
+            read_only:true, destructive:false, idempotent:true, open_world:false
+        })
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let input: Input = match parse_typed_input("get_element_security", args) {
+            Ok(input) => input,
+            Err(_) => return output(Security::Unknown, false, Some("invalid_arguments")),
+        };
+        if input.pid <= 0
+            || input.window_id == 0
+            || input.element_token.is_empty()
+            || input.element_token.len() > 1024
+            || input
+                .session
+                .as_ref()
+                .is_some_and(|value| value.len() > 128)
+        {
+            return output(Security::Unknown, false, Some("invalid_arguments"));
+        }
+        let resolved = match self.state.element_cache.resolve_element_args(
+            input.pid,
+            None,
+            Some(&input.element_token),
+            None,
+            Some(input.window_id as u64),
+            "get_element_security",
+        ) {
+            Ok(value) => value,
+            Err(_) => return output(Security::Unknown, false, Some("token_unconfirmed")),
+        };
+        let (_, window_id, element) = resolved.into_parts(Some(input.window_id as u64));
+        if window_id != Some(input.window_id as u64) {
+            return output(Security::Unknown, false, Some("target_unconfirmed"));
+        }
+        let Some(element) = element else {
+            return output(Security::Unknown, false, Some("token_unconfirmed"));
+        };
+        let result = tokio::task::spawn_blocking(move || unsafe {
+            let pointer = element.as_ptr() as AXUIElementRef;
+            let mut pid = 0;
+            if AXUIElementGetPid(pointer, &mut pid) != kAXErrorSuccess
+                || pid != input.pid
+                || element_window_id(pointer) != Some(input.window_id)
+                || resolve_window_owner(input.pid, input.window_id) != WindowOwner::SamePid
+            {
+                return (Security::Unknown, false, Some("target_unconfirmed"));
+            }
+            let (security, reason) = classify_exact(pointer, input.window_id);
+            (security, true, reason)
+        })
+        .await;
+        match result {
+            Ok((security, true, reason)) => output(security, true, reason),
+            Ok(_) => output(Security::Unknown, false, Some("target_unconfirmed")),
+            Err(_) => output(Security::Unknown, false, Some("query_failed")),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn positive_response_declares_the_guarded_input_contract() {
+        let result = output(Security::NonSensitive, true, None);
+        assert_eq!(result.structured_content.unwrap(), json!({
+            "schema_version":2, "input_guard_version":1, "classification":"non_sensitive",
+            "binding_verified":true, "reason":null
+        }));
+    }
+    #[test]
+    fn security_query_arguments_are_closed() {
+        let input = json!({"pid":1,"window_id":2,"element_token":"fixture"});
+        assert!(parse_typed_input::<Input>("get_element_security", input.clone()).is_ok());
+        let mut extra = input.clone();
+        extra["attribute"] = json!("AXValue");
+        assert!(parse_typed_input::<Input>("get_element_security", extra).is_err());
+        let mut wrong = input.clone();
+        wrong["pid"] = json!(true);
+        assert!(parse_typed_input::<Input>("get_element_security", wrong).is_err());
+        let mut wrong = input;
+        wrong["window_id"] = json!(4294967296_u64);
+        assert!(parse_typed_input::<Input>("get_element_security", wrong).is_err());
+    }
+}
