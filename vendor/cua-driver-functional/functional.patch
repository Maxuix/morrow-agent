diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/read_element_attribute.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/read_element_attribute.rs
new file mode 100644
index 0000000..0cf0267
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/read_element_attribute.rs
@@ -0,0 +1,104 @@
+//! Read one attribute from the same retained object, without a fresh tree lookup.
+use super::ToolState;
+use crate::ax::{
+    bindings::{copy_bool_attr, AXUIElementRef},
+    exact_target::element_window_id,
+};
+use async_trait::async_trait;
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{Tool, ToolDef},
+};
+use serde_json::{json, Value};
+use std::sync::{Arc, OnceLock};
+
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" {
+    fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> i32;
+    fn AXUIElementSetMessagingTimeout(element: AXUIElementRef, timeout: f32) -> i32;
+}
+
+pub struct ReadElementAttributeTool {
+    state: Arc<ToolState>,
+}
+impl ReadElementAttributeTool {
+    pub fn new(state: Arc<ToolState>) -> Self {
+        Self { state }
+    }
+}
+
+#[async_trait]
+impl Tool for ReadElementAttributeTool {
+    fn def(&self) -> &ToolDef {
+        static DEF: OnceLock<ToolDef> = OnceLock::new();
+        DEF.get_or_init(|| ToolDef {
+            name: "read_element_attribute".into(),
+            description: "Read enabled on the exact retained element_token from the current window snapshot. No selector, activation, input, or fresh snapshot is used.".into(),
+            input_schema: json!({"type":"object", "required":["pid","window_id","element_token","attribute"], "additionalProperties":false,
+                "properties":{"session":{"type":"string"},"pid":{"type":"integer","minimum":1},"window_id":{"type":"integer","minimum":1},"element_token":cua_driver_core::tool_schema::element_token_schema(),"attribute":{"type":"string","enum":["enabled"]}}}),
+            read_only:true, destructive:false, idempotent:true, open_world:false,
+        })
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        use cua_driver_core::tool_args::ArgsExt;
+        let pid = match args.require_i32("pid") {
+            Ok(p) if p > 0 => p,
+            _ => return ToolResult::error("invalid pid"),
+        };
+        let window_id = match args
+            .opt_u64("window_id")
+            .and_then(|w| u32::try_from(w).ok())
+            .filter(|w| *w > 0)
+        {
+            Some(w) => w,
+            None => return ToolResult::error("invalid window_id"),
+        };
+        if args.opt_str("attribute").as_deref() != Some("enabled") {
+            return ToolResult::error("unsupported attribute");
+        }
+        let token = match args.require_str("element_token") {
+            Ok(t) => t,
+            Err(e) => return e,
+        };
+        let retained = match self.state.element_cache.resolve_element_args(
+            pid,
+            None,
+            Some(&token),
+            None,
+            Some(u64::from(window_id)),
+            "read_element_attribute",
+        ) {
+            Ok(cua_driver_core::element_token::ResolvedElement::Element { element, .. }) => element,
+            Ok(_) => return ToolResult::error("element required"),
+            Err(e) => return e,
+        };
+        let read = tokio::task::spawn_blocking(move || unsafe {
+            let element = retained.as_ptr() as AXUIElementRef;
+            let _ = AXUIElementSetMessagingTimeout(element, 1.0);
+            let mut actual_pid = 0;
+            if AXUIElementGetPid(element, &mut actual_pid) != 0
+                || actual_pid != pid
+                || crate::windows::resolve_window_owner(pid, window_id)
+                    != crate::windows::WindowOwner::SamePid
+                || element_window_id(element) != Some(window_id)
+            {
+                return None;
+            }
+            let value = copy_bool_attr(element, "AXEnabled");
+            // The same retained object must still belong to this window after the read.
+            if element_window_id(element) != Some(window_id) {
+                return None;
+            }
+            value
+        })
+        .await;
+        match read {
+            Ok(Some(value)) => ToolResult::text("Exact attribute read.").with_structured(
+                json!({"identity":"exact","attribute":"enabled","status":"readable","value":value}),
+            ),
+            _ => ToolResult::text("Attribute unavailable.").with_structured(
+                json!({"identity":"exact","attribute":"enabled","status":"unavailable"}),
+            ),
+        }
+    }
+}
