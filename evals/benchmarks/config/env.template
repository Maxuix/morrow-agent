# Morrow Benchmark 运行环境变量模板（复制为 .env 后填写；切勿提交真实 key）
# provider 适配器：openai-compatible（OpenAI 兼容端点）| volcengine 等 Morrow 内置 preset
MORROW_BENCH_PROVIDER_ADAPTER=openai-compatible
MORROW_BENCH_PROVIDER_BASE_URL=https://api.openai.com/v1
MORROW_BENCH_PROVIDER_ID=bench
# 模型：Morrow 内部 model_id 与实际 API 模型名
MORROW_BENCH_MODEL_ID=bench-model
MORROW_BENCH_API_MODEL_ID=gpt-5
# 凭据：Morrow 约定 MORROW_<PROVIDER_ID>_API_KEY（provider_id 大写、'-'→'_'）
MORROW_BENCH_API_KEY=sk-replace-me
# 预算：全部 benchmark 的累计 token 硬上限（默认 100M）
MORROW_BENCH_TOKEN_BUDGET=100000000
# 每次 admission 的保守预留（默认 1M）
MORROW_BENCH_RESERVATION=1000000
# 并发（受本地 Docker 资源限制）
MORROW_BENCH_CONCURRENCY=4
# SWE-bench 实例镜像模板（{repo} {version} 占位符）；ghcr 不可达时改为可用镜像仓库，
# 或用 swebench image_builder 从官方 spec 本地构建
# MORROW_BENCH_SWE_IMAGE_TEMPLATE=ghcr.io/swe-bench/{repo}:{version}
